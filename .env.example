# ── App ──
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Database ──
DATABASE_URL=postgresql://user:pass@localhost:5432/vorzop

# ── Auth.js (web) ──
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── API auth bridge ──
API_JWT_SECRET=

# ── OAuth (P0: credentials; P1+: optional Google/Microsoft login) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# ── Object storage (S3-compatible / Cloudflare R2) ──
# When unset, reports use filesystem dev fallback under REPORT_STORAGE_PATH or OS temp dir.
S3_ENDPOINT=
S3_BUCKET=vorzop-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
REPORT_STORAGE_PATH=

# ── Email (P1+) ──
RESEND_API_KEY=
EMAIL_FROM=reports@vortexoptimizer.com

# ── Microsoft Graph (client tenant sync — P2 only) ──
# Register a multitenant Azure AD app; redirect URI must match API callback route.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_REDIRECT_URI=http://localhost:4000/v1/integrations/microsoft/callback
GRAPH_WEBHOOK_SECRET=
# Optional — defaults to API_JWT_SECRET for encrypting stored OAuth tokens
TOKEN_ENCRYPTION_KEY=

# ── Stripe (P2, GATED — do not require at boot) ──
STRIPE_CONNECTED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AUDIT=
STRIPE_PRICE_RETAINER=
STRIPE_PRICE_ENTERPRISE=

# ── Feature flags ──
FEATURE_GRAPH_SYNC=false
FEATURE_STRIPE=false
FEATURE_PDF_REPORTS=true
SEED_DEMO_DATA=true

# ── Sentry (optional — apps boot without DSN) ──
# Client (Vercel / Next.js browser + edge). Prefer NEXT_PUBLIC_ for client; SENTRY_DSN for server.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional source maps upload during `next build` (CI / Vercel only — never commit the token)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Trace sampling (0–1). Defaults to 0.1 when unset.
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Render (api) ──
PORT=4000
